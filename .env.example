# Copy to .env in the repo root for local development. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Proxies in front of the API whose X-Forwarded-For is trusted (for the per-IP login rate limit).
# Too low is safe (all clients share one limit); too high lets clients fake their IP.
TRUST_PROXY_HOPS=1

# --- MongoDB Atlas ---
# Atlas -> Database -> Connect -> Drivers. Include the database name (reklame) in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/reklame?retryWrites=true&w=majority
# atlas = Atlas Search index (diacritic-insensitive, fuzzy); basic = fallback for local/tests
SEARCH_MODE=atlas

# --- Authentication (single user) ---
# argon2 hash of your password: npm run hash-password -w server
# Keep the value in single quotes: it contains $ characters.
APP_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$REPLACE_ME'
# Random secret for signing session tokens, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
# Session lifetime (720 h = 30 days)
SESSION_TTL_HOURS=720
# Max login attempts per IP per window
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- Scheduled refresh ---
# Shared secret for POST /api/admin/refresh (header X-Refresh-Token), at least 32 characters
REFRESH_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# --- Scraper etiquette ---
SCRAPER_USER_AGENT="reklame-popusti/0.1 (personal price comparison; +https://github.com/NikPerne/reklame-popusti)"
# Minimum delay between requests to the same host (min 500)
SCRAPER_MIN_DELAY_MS=2000
# How long fetched responses are reused before re-fetching
SCRAPER_CACHE_TTL_MINUTES=60
