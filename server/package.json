    "@fastify/rate-limit": "^11.2.1",
    "@fastify/sensible": "^6.0.7",
    "@fastify/static": "^10.1.7",
    "@node-rs/argon2": "^2.2.2",
    "cheerio": "^1.2.0",
    "fastify": "^5.12.7",
